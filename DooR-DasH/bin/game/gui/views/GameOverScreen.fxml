<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" styleClass="game-over-screen" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.gui.controllers.GameOverController">
   <children>
      <ImageView fx:id="backgroundImage" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@../resources/images/StartScreen_Background.png" />
         </image>
      </ImageView>

      <VBox alignment="CENTER" spacing="30.0">
         <children>
            <Label text="GAME OVER" style="-fx-font-size: 60px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, black, 10, 0.5, 2, 2);" />
            <Label fx:id="winnerLabel" text="WINS!" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #ffcc00; -fx-effect: dropshadow(gaussian, black, 10, 0.5, 2, 2);" />
            
            <VBox alignment="CENTER" spacing="15.0" styleClass="game-over-actions">
               <children>
                  <Button onAction="#handleReplay" styleClass="primary-button" text="PLAY AGAIN" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-min-width: 250px;" />
                  <Button onAction="#handleMenu" styleClass="secondary-button" text="RETURN TO MENU" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-min-width: 250px;" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>
