<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" styleClass="start-screen" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.gui.controllers.StartController">
   <children>
      <ImageView fx:id="backgroundImage" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@../resources/images/StartScreen_Background.png" />
         </image>
      </ImageView>

      <VBox alignment="CENTER" spacing="50.0">
         <children>
            <ImageView fx:id="logoImage" fitHeight="233.0" fitWidth="405.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../resources/images/DoorDash_Logo.png" />
               </image>
            </ImageView>

            <HBox alignment="CENTER" spacing="100.0">
               <children>
                  <ImageView fx:id="scarerButton" fitHeight="369.0" fitWidth="205.0" onMouseClicked="#handlePlayAsScarer" pickOnBounds="true" style="-fx-cursor: hand;">
                     <image>
                        <Image url="@../resources/images/scarer_button.png" />
                     </image>
                  </ImageView>

                  <ImageView fx:id="laugherButton" fitHeight="369.0" fitWidth="205.0" onMouseClicked="#handlePlayAsLaugher" pickOnBounds="true" style="-fx-cursor: hand;">
                     <image>
                        <Image url="@../resources/images/laugher_button.png" />
                     </image>
                  </ImageView>
               </children>
            </HBox>

            <VBox alignment="CENTER" spacing="15.0">
               <children>
                  <Button fx:id="instructions_button" onAction="#handleInstructions" styleClass="secondary-button" text="INSTRUCTIONS" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-min-width: 200px;" />
                  <Button fx:id="exit_button" onAction="#handleExit" styleClass="ghost-button" text="EXIT" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-min-width: 200px;" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>