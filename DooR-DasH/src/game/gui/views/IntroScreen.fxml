<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="game.gui.controllers.IntroController"
           style="-fx-background-color: black;"
           prefWidth="1280" prefHeight="720">
    <children>

        <!-- Team credit + disclaimer -->
        <VBox alignment="CENTER" spacing="16">
            <Text fx:id="teamText"
                  text="A GAME BY TEAM 86"
                  style="-fx-fill: white; -fx-font-size: 58px; -fx-font-family: 'Georgia'; -fx-font-weight: bold;"
                  opacity="0" />
            <Text fx:id="disclaimerText"
                  text="disney please don't sue us, we are broke students 🙏"
                  style="-fx-fill: #aaaaaa; -fx-font-size: 20px; -fx-font-family: 'Georgia'; -fx-font-style: italic;"
                  opacity="0" />
        </VBox>

        <!-- Logo — same size as start screen, starts centered, moves to TOP_CENTER -->
        <ImageView fx:id="logoImage"
                   fitWidth="405" fitHeight="233"
                   preserveRatio="true"
                   pickOnBounds="true"
                   opacity="0"
                   StackPane.alignment="CENTER">
            <image>
                <Image url="@../resources/images/DoorDash_Logo.png" />
            </image>
        </ImageView>

    </children>
</StackPane>