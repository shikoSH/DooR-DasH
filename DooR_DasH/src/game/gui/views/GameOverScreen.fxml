<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<StackPane fx:id="rootPane"
           styleClass="game-over-screen"
           xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="game.gui.controllers.GameOverController">
   <children>

      <!-- Background: NO <Image> tag — loaded in controller to avoid OOM -->
      <ImageView fx:id="backgroundImage"
                 mouseTransparent="true"
                 pickOnBounds="true"
                 preserveRatio="false" />

      <AnchorPane fx:id="overlayPane"
                  maxHeight="1.7976931348623157E308"
                  maxWidth="1.7976931348623157E308"
                  prefHeight="920.0"
                  prefWidth="1280.0"
                  style="-fx-background-color: transparent;">
         <children>

            <!-- Winner banner -->
            <Label fx:id="winsLabel"
                   alignment="CENTER"
                   layoutX="140.0"
                   layoutY="370.0"
                   prefHeight="80.0"
                   prefWidth="1000.0"
                   text=""
                   textAlignment="CENTER"
                   textFill="#e5fa03"
                   wrapText="true">
               <font>
                  <Font name="Book Antiqua Bold" size="42.0" />
               </font>
            </Label>

            <!-- RETRY button — raised higher, glow wired in controller -->
            <Button fx:id="retryButton"
                    layoutX="310.0"
                    layoutY="630.0"
                    mnemonicParsing="false"
                    onAction="#handleReplay"
                    prefHeight="72.0"
                    prefWidth="240.0"
                    text="RETRY" />

            <!-- MENU button — raised higher, glow wired in controller -->
            <Button fx:id="mainMenuButton"
                    layoutX="630.0"
                    layoutY="630.0"
                    mnemonicParsing="false"
                    onAction="#handleMainMenu"
                    prefHeight="72.0"
                    prefWidth="240.0"
                    text="MENU" />

         </children>
      </AnchorPane>
   </children>
</StackPane>
