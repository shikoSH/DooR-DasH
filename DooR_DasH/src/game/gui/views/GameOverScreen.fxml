<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<StackPane fx:id="rootPane"
           styleClass="game-over-screen"
           stylesheets="@../resources/styles/game.css"
           xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="game.gui.controllers.GameOverController">
   <children>
      <!-- Background: NO <Image> tag — loaded in controller to avoid OOM -->
      <ImageView fx:id="backgroundImage"
                 mouseTransparent="true"
                 pickOnBounds="true"
                 preserveRatio="false" />
      <AnchorPane fx:id="overlayPane"
            maxHeight="Infinity"
            maxWidth="Infinity"
            styleClass="overlay-pane">
         <children>
            <!-- Winner banner — centered under baked-in "GAME OVER" text -->
            <Label fx:id="winsLabel"
                   alignment="CENTER"
                   maxWidth="Infinity"
                   prefHeight="96.0"
                   text=""
                   textAlignment="CENTER"
                   wrapText="true"
                   styleClass="game-over-title"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0"
                   AnchorPane.topAnchor="330.0">
               <font>
                  <Font name="Book Antiqua Bold" size="48.0" />
               </font>
            </Label>
            <!-- Action buttons — equal width, centered row -->
            <HBox fx:id="buttonRow"
                  alignment="CENTER"
                  spacing="40.0"
                  styleClass="game-over-buttons"
                  AnchorPane.bottomAnchor="100.0"
                  AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0">
               <children>
                  <Button fx:id="retryButton"
                         mnemonicParsing="false"
                         onAction="#handleReplay"
                         minWidth="240.0"
                         prefHeight="72.0"
                         prefWidth="240.0"
                         text="RETRY"
                         styleClass="primary-button" />
                  <Button fx:id="mainMenuButton"
                         mnemonicParsing="false"
                         onAction="#handleMainMenu"
                         minWidth="240.0"
                         prefHeight="72.0"
                         prefWidth="240.0"
                         text="MENU"
                         styleClass="secondary-button" />
               </children>
            </HBox>
         </children>
      </AnchorPane>
   </children>
</StackPane>
