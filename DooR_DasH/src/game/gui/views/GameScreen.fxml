<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="backgroundRoot"
           maxHeight="Infinity"
           maxWidth="Infinity"
           xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="game.gui.controllers.GameController">

    <children>

        <!-- Background -->
        <ImageView fx:id="backgroundView"
                   pickOnBounds="true"
                   preserveRatio="false" />

        <!-- Control panel overlay -->
        <ImageView fx:id="controlPanelView"
                   pickOnBounds="true"
                   preserveRatio="false" />

        <!-- Main layout -->
        <BorderPane fx:id="masterLayout"
                    maxHeight="Infinity"
                    maxWidth="Infinity">

            <!-- TOP -->
            <top>
                <Label fx:id="myLabel"
                       alignment="CENTER"
                       maxWidth="Infinity"
                       text="Loading..."
                       style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-padding: 5 0 3 0;
                              -fx-text-fill: #00ff88;"
                       BorderPane.alignment="CENTER" />
            </top>

            <!-- LEFT -->
            <left>
                <VBox fx:id="playerPanelContainer"
                      alignment="TOP_CENTER"
                      prefWidth="215"
                      spacing="4"
                      style="-fx-padding: 10 6 6 6;"
                      BorderPane.alignment="CENTER" />
            </left>

            <!-- RIGHT -->
            <right>
                <VBox alignment="TOP_CENTER"
                      prefWidth="215"
                      spacing="4"
                      style="-fx-padding: 10 6 6 6;"
                      BorderPane.alignment="CENTER">

                    <children>
                        <VBox fx:id="opponentPanelContainer"
                              spacing="4" />

                        <VBox fx:id="actionLogContainer"
                              spacing="3" />

                        <VBox fx:id="diceContainer"
                              spacing="3" />
                    </children>

                </VBox>
            </right>

            <!-- CENTER -->
            <center>

                <StackPane fx:id="boardContainer"
                           maxHeight="Infinity"
                           maxWidth="Infinity"
                           BorderPane.alignment="CENTER">

                    <BorderPane.margin>
                        <Insets top="6"
                                right="6"
                                bottom="118"
                                left="6" />
                    </BorderPane.margin>

                    <children>

                        <!-- BOARD HOLDER (must be first / behind everything) -->
                        <ImageView fx:id="boardHolderView"
                                   pickOnBounds="true"
                                   preserveRatio="false" />

                        <!-- BOARD IMAGE -->
                        <ImageView fx:id="boardImageView"
                                   pickOnBounds="true"
                                   preserveRatio="false" />

                        <!-- GRID -->
                        <GridPane fx:id="grid"
                                  gridLinesVisible="false">

                            <columnConstraints>
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                            </columnConstraints>

                            <rowConstraints>
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                            </rowConstraints>

                        </GridPane>

                    </children>

                </StackPane>

            </center>

            <!-- BOTTOM -->
            <bottom>

                <AnchorPane fx:id="controlBar"
                            maxWidth="Infinity"
                            prefHeight="118"
                            BorderPane.alignment="CENTER">

                    <children>

                        <!-- CARD DECK -->
                        <ImageView fx:id="cardDeckView"
                                   fitHeight="88"
                                   fitWidth="68"
                                   preserveRatio="true"
                                   AnchorPane.topAnchor="8"
                                   AnchorPane.leftAnchor="80" />

                        <!-- DICE -->
                        <ImageView fx:id="diceView"
                                   fitHeight="100"
                                   fitWidth="100"
                                   preserveRatio="true"
                                   AnchorPane.topAnchor="6"
                                   AnchorPane.leftAnchor="0"
                                   AnchorPane.rightAnchor="0" />

                        <!-- DICE RESULT -->
                        <Label fx:id="diceResultLabel"
                               text="—"
                               alignment="CENTER"
                               maxWidth="Infinity"
                               style="-fx-text-fill: #00ff88;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"
                               AnchorPane.bottomAnchor="2"
                               AnchorPane.leftAnchor="0"
                               AnchorPane.rightAnchor="0" />

                        <!-- POWER UP -->
                        <ImageView fx:id="powerUpImageBtn"
                                   fitHeight="75"
                                   fitWidth="115"
                                   pickOnBounds="true"
                                   preserveRatio="true"
                                   style="-fx-cursor: hand;"
                                   onMouseClicked="#handlePowerUp"
                                   AnchorPane.topAnchor="14"
                                   AnchorPane.rightAnchor="135" />

                        <!-- ROLL BUTTON -->
                        <ImageView fx:id="rollImageBtn"
                                   fitHeight="75"
                                   fitWidth="115"
                                   pickOnBounds="true"
                                   preserveRatio="true"
                                   style="-fx-cursor: hand;"
                                   onMouseClicked="#handleRollDice"
                                   AnchorPane.topAnchor="14"
                                   AnchorPane.rightAnchor="10" />

                    </children>

                </AnchorPane>

            </bottom>

        </BorderPane>

    </children>

</StackPane>