<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="backgroundRoot"
           maxHeight="Infinity" maxWidth="Infinity"
           xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="game.gui.controllers.GameController">
    <children>

        <!-- Background — slight blur applied in controller -->
        <ImageView fx:id="backgroundView"
                   pickOnBounds="true" preserveRatio="false" />

        <!-- Control panel overlay -->
        <ImageView fx:id="controlPanelView"
                   pickOnBounds="true" preserveRatio="false" />

        <!-- ==========================================================
             Main layout — AnchorPane instead of BorderPane.
             Every child below is positioned/sized purely from the
             GameController's uniform `scale` number, computed once per
             layout pass in applyAllLayout(). None of them depend on a
             sibling's size or content the way BorderPane's top/left/
             right/center/bottom region negotiation used to — that
             negotiation was the source of the board/panels shifting
             slightly whenever a VBox's measured content size changed
             (e.g. from font metrics differing slightly between
             machines). Board internals below are left exactly as they
             were — the GridPane's own row/col percent constraints
             already don't have this problem once its container's size
             is fixed, which it now always is.
             ========================================================== -->
        <AnchorPane fx:id="masterLayout"
                    maxHeight="Infinity" maxWidth="Infinity">
            <children>

                <Label fx:id="myLabel"
                       alignment="CENTER"
                       maxWidth="Infinity"
                       text="Loading..."
                       style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-padding: 5 0 3 0;
                              -fx-text-fill: #00ff88;"
                       AnchorPane.leftAnchor="0"
                       AnchorPane.rightAnchor="0"
                       AnchorPane.topAnchor="0" />

                <!-- LEFT: player panel — built entirely in PanelBuilder.
                     Still a VBox internally (that's fine — a VBox's own
                     height never leaks out and affects a sibling once
                     its PARENT position/width here is fixed by hard
                     numbers instead of BorderPane region negotiation). -->
                <VBox fx:id="playerPanelContainer"
                      alignment="TOP_CENTER"
                      spacing="4"
                      style="-fx-padding: 10 6 6 6;" />

                <!-- RIGHT: opponent panel -->
                <VBox fx:id="opponentPanelContainer"
                      alignment="TOP_CENTER"
                      spacing="4"
                      style="-fx-padding: 10 6 6 6;" />

                <!-- RIGHT, below opponent panel: action log -->
                <VBox fx:id="actionLogContainer"
                      alignment="TOP_CENTER"
                      spacing="3"
                      style="-fx-padding: 4 6 4 6;" />

                <!-- CENTER: board — internals unchanged, per the plan to
                     leave the board exactly as-is. -->
                <StackPane fx:id="boardContainer"
                           maxHeight="Infinity" maxWidth="Infinity">
                    <children>
                        <ImageView fx:id="boardHolderView"
                                   pickOnBounds="true" preserveRatio="false" />
                        <ImageView fx:id="boardImageView"
                                   pickOnBounds="true" preserveRatio="false" />
                        <GridPane fx:id="grid" gridLinesVisible="false">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                                <ColumnConstraints percentWidth="10.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                                <RowConstraints percentHeight="10.0" />
                            </rowConstraints>
                        </GridPane>
                    </children>
                </StackPane>

                <!-- BOTTOM: control bar — internals unchanged -->
                <AnchorPane fx:id="controlBar"
                            maxWidth="Infinity"
                            prefHeight="118">
                    <children>

                        <!-- CARD DECK -->
                        <ImageView fx:id="cardDeckView"
                                   fitHeight="88" fitWidth="68"
                                   preserveRatio="true"
                                   AnchorPane.leftAnchor="80"
                                   AnchorPane.topAnchor="8" />

                        <!-- DICE -->
                        <ImageView fx:id="diceView"
                                   fitHeight="100" fitWidth="100"
                                   preserveRatio="true"
                                   AnchorPane.leftAnchor="0"
                                   AnchorPane.rightAnchor="0"
                                   AnchorPane.topAnchor="6" />

                        <!-- DICE RESULT -->
                        <Label fx:id="diceResultLabel"
                               alignment="CENTER"
                               maxWidth="Infinity"
                               text="—"
                               style="-fx-text-fill: #00ff88;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"
                               AnchorPane.bottomAnchor="2"
                               AnchorPane.leftAnchor="0"
                               AnchorPane.rightAnchor="0" />

                        <!-- POWER UP -->
                        <ImageView fx:id="powerUpImageBtn"
                                   fitHeight="75" fitWidth="115"
                                   pickOnBounds="true"
                                   preserveRatio="true"
                                   style="-fx-cursor: hand;"
                                   onMouseClicked="#handlePowerUp"
                                   AnchorPane.rightAnchor="135"
                                   AnchorPane.topAnchor="14" />

                        <!-- ROLL BUTTON -->
                        <ImageView fx:id="rollImageBtn"
                                   fitHeight="75" fitWidth="115"
                                   pickOnBounds="true"
                                   preserveRatio="true"
                                   style="-fx-cursor: hand;"
                                   onMouseClicked="#handleRollDice"
                                   AnchorPane.rightAnchor="10"
                                   AnchorPane.topAnchor="14" />

                    </children>
                </AnchorPane>

            </children>
        </AnchorPane>
    </children>
</StackPane>
