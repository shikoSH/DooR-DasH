<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" styleClass="game-over-screen" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.gui.controllers.GameOverController">
   <children>
      <ImageView fx:id="backgroundImage" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@../resources/images/FinalGameOverScreen.png" />
         </image>
      </ImageView>
      <AnchorPane prefHeight="200.0" prefWidth="200.0">
         <children>
            <Button fx:id="retryButton" layoutX="435.0" layoutY="646.0" mnemonicParsing="false" opacity="0.0" prefHeight="90.0" prefWidth="165.0" />
            <Button fx:id="mainMenuButton" layoutX="757.0" layoutY="668.0" mnemonicParsing="false" opacity="0.0" prefHeight="46.0" prefWidth="52.0" textFill="#534d4d" />
            <Label fx:id="winsLabel" alignment="CENTER" layoutX="236.0" layoutY="546.0" prefHeight="83.0" prefWidth="941.0" text="WINS" textAlignment="CENTER" textFill="#e5fa03" wrapText="true">
               <font>
                  <Font name="Book Antiqua" size="54.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </children>
</StackPane>
