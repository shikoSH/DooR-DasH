<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.gui.controllers.GameOverController" styleClass="game-over-screen">
    <center>
        <VBox alignment="CENTER" spacing="30">
            <Label text="GAME OVER" styleClass="title-label"/>
            <Label fx:id="winnerLabel" text="WINS!" styleClass="subtitle-label, winner-label"/>
            
            <VBox alignment="CENTER" spacing="15" styleClass="game-over-actions">
                <Button text="PLAY AGAIN" onAction="#handleReplay" styleClass="primary-button"/>
                <Button text="RETURN TO MENU" onAction="#handleMenu" styleClass="secondary-button"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
