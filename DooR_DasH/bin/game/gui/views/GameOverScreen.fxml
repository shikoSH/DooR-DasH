<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<StackPane fx:id="rootPane"
           styleClass="game-over-screen"
           stylesheets="@../resources/styles/game.css"
           xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="game.gui.controllers.GameOverController">
   <children>
      <!-- Background: NO <Image> tag — loaded in controller to avoid OOM -->
      <ImageView fx:id="backgroundImage"
                 mouseTransparent="true"
                 pickOnBounds="true"
                 preserveRatio="false" />
      <AnchorPane fx:id="overlayPane"
            maxHeight="1.7976931348623157E308"
            maxWidth="1.7976931348623157E308"
            prefHeight="920.0"
            prefWidth="1280.0"
            styleClass="overlay-pane">
         <children>
            <!-- Winner banner — moved 100px down via topAnchor -->
            <Label fx:id="winsLabel"
                   alignment="CENTER"
                   prefHeight="96.0"
                   prefWidth="1000.0"
                   text=""
                   textAlignment="CENTER"
                   wrapText="true"
                   styleClass="game-over-title"
                   AnchorPane.topAnchor="100.0"
                   AnchorPane.leftAnchor="140.0">
               <font>
                  <Font name="Book Antiqua Bold" size="48.0" />
               </font>
            </Label>
            <!-- RETRY button -->
            <Button fx:id="retryButton"
                   mnemonicParsing="false"
                   onAction="#handleReplay"
                   prefHeight="72.0"
                   prefWidth="240.0"
                   text="RETRY"
                   styleClass="primary-button" />
            <!-- MENU button -->
            <Button fx:id="mainMenuButton"
                   mnemonicParsing="false"
                   onAction="#handleMainMenu"
                   prefHeight="72.0"
                   prefWidth="240.0"
                   text="MENU"
                   styleClass="secondary-button" />
         </children>
      </AnchorPane>
   </children>
</StackPane>
