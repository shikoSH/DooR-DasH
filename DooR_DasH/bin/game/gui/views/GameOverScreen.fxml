<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" styleClass="game-over-screen" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.gui.controllers.GameOverController">
   <children>
      <ImageView fx:id="backgroundImage" mouseTransparent="true" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@../resources/images/FinalGameOverScreen.png" />
         </image>
      </ImageView>
<AnchorPane fx:id="overlayPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="920.0" prefWidth="1280.0" style="-fx-background-color: transparent;">         <children>
            <Label fx:id="winsLabel" alignment="CENTER" layoutX="194.0" layoutY="633.0" prefHeight="70.0" prefWidth="980.0" text="WINS" textAlignment="CENTER" textFill="#e5fa03" wrapText="true">
               <font>
                  <Font name="Book Antiqua" size="36.0" />
               </font>
            </Label>
            <Button fx:id="mainMenuButton" layoutX="728.0" layoutY="734.0" mnemonicParsing="false" onAction="#handleMainMenu" prefHeight="91.0" prefWidth="220.0" text="MENU" />
            <Button fx:id="retryButton" layoutX="396.0" layoutY="734.0" mnemonicParsing="false" prefHeight="91.0" prefWidth="277.0" text="RETRY" />
         </children>
      </AnchorPane>
   </children>
</StackPane>
