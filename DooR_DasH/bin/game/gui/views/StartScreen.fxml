<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootPane" styleClass="start-screen" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.gui.controllers.StartController">
   <children>

      <!-- Background — bottom layer -->
      <ImageView fx:id="backgroundImage" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@../resources/images/StartScreen_Background.png" />
         </image>
      </ImageView>

      <!-- LOGO PANE — second layer, beams behind UI but above background -->
      <!-- Change translateY to move up/down: negative = up, positive = down -->
      <StackPane fx:id="logoPane" mouseTransparent="true" pickOnBounds="false" translateY="-300" StackPane.alignment="TOP_CENTER">
         <children>
            <ImageView fx:id="logoImage" fitHeight="386" fitWidth="692" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../resources/images/DoorDash_Logo.png" />
               </image>
            </ImageView>
         </children>
      </StackPane>

      <!-- Main layout — on top of beams -->
      <AnchorPane fx:id="mainPane">
         <children>

            <!-- CENTER ROW: scarer | laugher | instructions -->
            <HBox fx:id="centerRow" alignment="CENTER" spacing="40" AnchorPane.bottomAnchor="130" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="240">

               <ImageView fx:id="scarerButton" fitHeight="360" fitWidth="200" onMouseClicked="#handlePlayAsScarer" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                  <image>
                     <Image url="@../resources/images/scarer_button.png" />
                  </image>
               </ImageView>

               <ImageView fx:id="laugherButton" fitHeight="360" fitWidth="200" onMouseClicked="#handlePlayAsLaugher" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                  <image>
                     <Image url="@../resources/images/laugher_button.png" />
                  </image>
               </ImageView>

               <ImageView fx:id="instructionsNote" fitHeight="420" fitWidth="320" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../resources/images/Instructions_Note.png" />
                  </image>
               </ImageView>

            </HBox>

            <!-- BOTTOM LEFT PANEL -->
            <ImageView fx:id="bottomLeftPanel" fitHeight="110" fitWidth="440" pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
               <image>
                  <Image url="@../resources/images/Bottom_Left_Panel_Start_Screen.png" />
               </image>
            </ImageView>

            <!-- BOTTOM BUTTONS -->
            <HBox fx:id="bottomButtonsRow" alignment="CENTER_LEFT" spacing="20.0" AnchorPane.bottomAnchor="5" AnchorPane.leftAnchor="8">

               <ImageView fx:id="exitButton" fitHeight="75" fitWidth="130" onMouseClicked="#handleExit" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                  <image>
                     <Image url="@../resources/images/Exit_Button.png" />
                  </image>
               </ImageView>

               <ImageView fx:id="optionsButton" fitHeight="75" fitWidth="130" onMouseClicked="#handleOptions" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                  <image>
                     <Image url="@../resources/images/Options_Button.png" />
                  </image>
               </ImageView>

               <ImageView fx:id="creditsButton" fitHeight="75" fitWidth="130" onMouseClicked="#handleCredits" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                  <image>
                     <Image url="@../resources/images/Credits_Button.png" />
                  </image>
               </ImageView>

            </HBox>

            <!-- OPTIONS POPUP -->
            <StackPane fx:id="optionsPopup" visible="false" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="180">
               <children>
                  <VBox alignment="CENTER" maxWidth="480" spacing="22" style="-fx-background-color: rgba(10,10,20,0.92);                                -fx-background-radius: 18;                                -fx-border-color: #FFD700;                                -fx-border-width: 2;                                -fx-border-radius: 18;                                -fx-padding: 36 40 36 40;                                -fx-effect: dropshadow(gaussian,black,30,0.6,0,0);">
                     <Text style="-fx-fill: #FFD700; -fx-font-size: 26px;                                   -fx-font-weight: bold; -fx-font-family: Georgia;" text="⚙ OPTIONS" />
                     <HBox alignment="CENTER" spacing="14">
                        <Text style="-fx-fill: white; -fx-font-size: 15px;" text="🔊 Volume" />
                        <Slider fx:id="volumeSlider" max="1" min="0" prefWidth="180" style="-fx-accent: #FFD700;" value="0.5" />
                        <Text fx:id="volumeLabel" style="-fx-fill: #FFD700; -fx-font-size: 14px;                                      -fx-font-weight: bold;" text="50%" />
                     </HBox>
                     <HBox alignment="CENTER" spacing="16">
                        <Button fx:id="muteButton" onAction="#handleMute" style="-fx-background-color: #8B0000;                                        -fx-text-fill: white; -fx-font-size: 13px;                                        -fx-font-weight: bold; -fx-padding: 8 22;                                        -fx-background-radius: 8; -fx-cursor: hand;" text="🔇 MUTE" />
                        <Button onAction="#handleCloseOptions" style="-fx-background-color: #333;                                        -fx-text-fill: white; -fx-font-size: 13px;                                        -fx-font-weight: bold; -fx-padding: 8 22;                                        -fx-background-radius: 8; -fx-cursor: hand;" text="✕  CLOSE" />
                     </HBox>
                  </VBox>
               </children>
            </StackPane>

            <!-- CREDITS POPUP -->
            <StackPane fx:id="creditsPopup" visible="false" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="140">
               <children>
                  <VBox alignment="CENTER" maxWidth="520" spacing="14" style="-fx-background-color: rgba(10,10,20,0.92);                                -fx-background-radius: 18;                                -fx-border-color: #FFD700;                                -fx-border-width: 2;                                -fx-border-radius: 18;                                -fx-padding: 36 48 36 48;                                -fx-effect: dropshadow(gaussian,black,30,0.6,0,0);">
                     <Text style="-fx-fill: #FFD700; -fx-font-size: 28px;                                   -fx-font-weight: bold; -fx-font-family: Georgia;" text="✦ CREDITS ✦" />
                     <Text style="-fx-fill: white; -fx-font-size: 20px;                                   -fx-font-weight: bold; -fx-font-family: Georgia;" text="TEAM 86" />
                     <Text style="-fx-fill: #FFD700; -fx-font-size: 12px;" text="━━━━━━━━━━━━━━━━━━━━━━" />
                     <Text style="-fx-fill: #dddddd; -fx-font-size: 16px;                                   -fx-font-family: Georgia;" text="Yassin Elsetohy  —  64-10815" />
                     <Text style="-fx-fill: #dddddd; -fx-font-size: 16px;                                   -fx-font-family: Georgia;" text="Sherif Tamer  —  64-11320" />
                     <Text style="-fx-fill: #dddddd; -fx-font-size: 16px;                                   -fx-font-family: Georgia;" text="Ahmed Walid  —  64-25319" />
                     <Text style="-fx-fill: #dddddd; -fx-font-size: 16px;                                   -fx-font-family: Georgia;" text="Ziad Yasser  —  65-33790" />
                     <Text style="-fx-fill: #FFD700; -fx-font-size: 12px;" text="━━━━━━━━━━━━━━━━━━━━━━" />
                     <Button onAction="#handleCloseCredits" style="-fx-background-color: #333;                                     -fx-text-fill: white; -fx-font-size: 13px;                                     -fx-font-weight: bold; -fx-padding: 8 28;                                     -fx-background-radius: 8; -fx-cursor: hand;" text="✕  CLOSE" />
                  </VBox>
               </children>
            </StackPane>

         </children>
      </AnchorPane>

   </children>
</StackPane>
